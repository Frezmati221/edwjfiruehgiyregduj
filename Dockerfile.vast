# Vast.ai Docker Template for Forex AI Training

FROM nvidia/cuda:12.1-devel-ubuntu22.04

# Install Python and system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    git \
    wget \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip3 install --upgrade pip
RUN pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
RUN pip3 install yfinance pandas numpy talib-binary scikit-learn tqdm matplotlib seaborn

# Set working directory
WORKDIR /workspace

# Copy training scripts (you'll upload these)
COPY . /workspace/

# Make setup script executable
RUN chmod +x /workspace/vast_setup.sh

# Default command
CMD ["/bin/bash", "/workspace/vast_setup.sh"]
